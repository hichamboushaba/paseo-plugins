{
  "name": "paseo-keep-awake",
  "version": "0.1.1",
  "private": true,
  "description": "Keeps the daemon host awake while Paseo agents and their subagents are working.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "keep-awake",
    "caffeinate",
    "sleep",
    "power-management"
  ],
  "author": "Hicham Boushaba",
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "!**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test *.test.ts shared/*.test.ts server/*.test.ts client/*.test.ts"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.0-beta.2",
    "@getpaseo/plugin": "0.9.0-beta.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
